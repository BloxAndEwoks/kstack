{
  "description": "kstack session hooks — Claude Code format. SessionStart injects the unit's ground-truth context; Stop watches the PR for new comments, failing checks, and pending findings.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/mcp/review-state.mjs --print-context 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/mcp/review-state.mjs --watch 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
