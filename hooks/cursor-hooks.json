{
  "description": "kstack session hooks — Cursor format (camelCase events). sessionStart injects the unit's ground-truth context; stop watches the PR for new comments, failing checks, and pending findings.",
  "hooks": {
    "sessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=\"${CURSOR_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-.}}}\"; /bin/sh \"$P/mcp/run.sh\" --print-context 2>/dev/null || true"
          }
        ]
      }
    ],
    "stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=\"${CURSOR_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-.}}}\"; /bin/sh \"$P/mcp/run.sh\" --watch 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
